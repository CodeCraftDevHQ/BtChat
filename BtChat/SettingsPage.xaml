<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BtChat"
             x:Name="SettingsRoot"
             x:Class="BtChat.SettingsPage"
             Title="{Binding [settings], Source={x:Static local:Loc.Instance}}">
    <Grid RowDefinitions="Auto,*" Padding="16,12,16,0" RowSpacing="8"
          FlowDirection="{Binding Flow, Source={x:Static local:Loc.Instance}}">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{Binding [settings], Source={x:Static local:Loc.Instance}}"
                   FontSize="26" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="✕" Style="{StaticResource QuietButton}" FontSize="20"
                    Clicked="OnCloseClicked" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="0,4,0,32">

                <Label Style="{StaticResource SectionLabel}"
                       Text="{Binding [setProfile], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding [myName], Source={x:Static local:Loc.Instance}}" FontSize="14" />
                        <Entry Text="{Binding MyName}" MaxLength="40" />
                        <Label Text="{Binding [myNameHint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionLabel}"
                       Text="{Binding [setAppearance], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding [setLanguage], Source={x:Static local:Loc.Instance}}" FontSize="14" />
                            <local:Segmented Items="{Binding LanguageItems}" SelectedIndex="{Binding LanguageIndex}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding [setTheme], Source={x:Static local:Loc.Instance}}" FontSize="14" />
                            <local:Segmented Items="{Binding ThemeItems}" SelectedIndex="{Binding ThemeIndex}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionLabel}"
                       Text="{Binding [setTransfer], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding [concurrentFiles], Source={x:Static local:Loc.Instance}}"
                                   FontSize="14" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ConcurrentFiles}" />
                        </Grid>
                        <Label Text="{Binding [concurrentFilesHint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionLabel}"
                       Text="{Binding [setPermissions], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="2"
                                             BindableLayout.ItemsSource="{Binding PermissionItems, Source={x:Reference SettingsRoot}}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" MinimumHeightRequest="52">
                                        <Button Text="ℹ️" FontSize="18" Padding="0" WidthRequest="40" HeightRequest="40"
                                                Style="{StaticResource QuietButton}" VerticalOptions="Center"
                                                Clicked="OnPermissionInfoClicked" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                            <Label Text="{Binding Title}" FontSize="14" />
                                            <Label Text="{Binding StateText}" FontSize="12" TextColor="Gray" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="2" VerticalOptions="Center"
                                                IsToggled="{Binding Granted, Mode=OneWay}"
                                                IsVisible="{Binding CanToggle}"
                                                Toggled="OnPermissionToggled" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding [permHint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionLabel}"
                       Text="{Binding [setLock], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding [lockEnable], Source={x:Static local:Loc.Instance}}"
                                   FontSize="14" VerticalOptions="Center" />
                            <Switch x:Name="LockSwitch" Grid.Column="1" Toggled="OnLockToggled" />
                        </Grid>
                        <Label Text="{Binding [lockHint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" />
                        <VerticalStackLayout x:Name="LockOptions" Spacing="8" IsVisible="False">
                            <Label Text="{Binding [lockDelayLabel], Source={x:Static local:Loc.Instance}}"
                                   FontSize="12" TextColor="Gray" />
                            <Picker x:Name="LockDelayPicker" SelectedIndexChanged="OnLockDelayChanged" />
                            <Grid x:Name="LockBioRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
                                <Label Text="{Binding [lockBio], Source={x:Static local:Loc.Instance}}"
                                       FontSize="14" VerticalOptions="Center" />
                                <Switch x:Name="LockBioSwitch" Grid.Column="1" Toggled="OnLockBioToggled" />
                            </Grid>
                            <Button Text="{Binding [lockChangePin], Source={x:Static local:Loc.Instance}}"
                                    Clicked="OnLockChangePinClicked" />
                            <Button Text="{Binding [lockNow], Source={x:Static local:Loc.Instance}}"
                                    Clicked="OnLockNowClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionLabel}"
                       Text="{Binding [setSecurity], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding [encrypt], Source={x:Static local:Loc.Instance}}"
                                   FontSize="14" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding EncryptionEnabled}" />
                        </Grid>
                        <Label Text="{Binding [encryptHint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding EncryptionApplyHint}" FontSize="12" TextColor="Gray" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
                            <Label Text="{Binding [verifyPeers], Source={x:Static local:Loc.Instance}}"
                                   FontSize="14" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding VerifyPeers}" />
                        </Grid>
                        <Label Text="{Binding [verifyPeersHint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding [myFingerprint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" Margin="0,6,0,0" />
                        <Label Text="{Binding LocalFingerprintText}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionLabel}" IsVisible="{Binding CanOpenBatterySettings}"
                       Text="{Binding [setBackground], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding CanOpenBatterySettings}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding [notifyMessages], Source={x:Static local:Loc.Instance}}"
                                   FontSize="14" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding MessageNotifications}" />
                        </Grid>
                        <Label Text="{Binding [notifyMessagesHint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" />
                        <BoxView HeightRequest="1" Color="Gray" Opacity="0.25" Margin="0,4" />
                        <Label Text="{Binding [batteryGuideTitle], Source={x:Static local:Loc.Instance}}"
                               FontSize="14" FontAttributes="Bold" />
                        <Label Text="{Binding BatteryStatusText}" FontSize="13" TextColor="{Binding BatteryStatusColor}" />
                        <Label Text="{Binding [batterySteps], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" IsVisible="{Binding BatteryNeedsFix}" />
                        <Label Text="{Binding BatteryBrandGuide}" FontSize="12" TextColor="Gray"
                               IsVisible="{Binding HasBatteryBrandGuide}" />
                        <Button Text="{Binding [batteryOpen], Source={x:Static local:Loc.Instance}}"
                                Command="{Binding BatterySettingsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionLabel}"
                       Text="{Binding [setAdvanced], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Button Text="{Binding [logTitle], Source={x:Static local:Loc.Instance}}"
                                Clicked="OnLogClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionLabel}"
                       Text="{Binding [setAbout], Source={x:Static local:Loc.Instance}}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Button Text="{Binding [guideOpen], Source={x:Static local:Loc.Instance}}"
                                Clicked="OnGuideClicked" />
                        <Button Text="{Binding [winDownload], Source={x:Static local:Loc.Instance}}"
                                Clicked="OnWindowsDownloadClicked" />
                        <Label Text="{Binding [winDownloadHint], Source={x:Static local:Loc.Instance}}"
                               FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="VersionLabel" FontSize="12" TextColor="Gray" HorizontalOptions="Center" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
