<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BtChat"
             x:Class="BtChat.MainPage">
    <Grid FlowDirection="LeftToRight">
        <Grid x:Name="MainArea" RowDefinitions="Auto,Auto,*,Auto" Padding="8" RowSpacing="6"
              FlowDirection="{Binding Flow, Source={x:Static local:Loc.Instance}}">
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8,6">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                    <Button Text="☰" FontSize="22" Padding="0" WidthRequest="40" HeightRequest="40"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding ToggleDrawerCommand}" IsVisible="{Binding ShowMenuButton}" />
                    <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                            StrokeShape="RoundRectangle 21" BackgroundColor="{StaticResource AccentColor}">
                        <Label Text="{Binding CurrentInitial}" TextColor="White" FontAttributes="Bold" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                        <Label Text="{Binding CurrentTitle}" FontAttributes="Bold" FontSize="17" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="●" FontSize="10" TextColor="{Binding ConnectionDot}" VerticalOptions="Center" />
                            <Label Text="{Binding Status}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        </HorizontalStackLayout>
 </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="3" Spacing="0" VerticalOptions="Center">
                        <Button Text="📹" FontSize="20" Padding="0" WidthRequest="40" HeightRequest="40"
                                Style="{StaticResource QuietButton}" VerticalOptions="Center"
                                Command="{Binding StartVideoCallCommand}" IsEnabled="{Binding CanSend}" IsVisible="{Binding ShowVideoCallButton}" />
                        <Button Text="📞" FontSize="20" Padding="0" WidthRequest="40" HeightRequest="40"
                                Style="{StaticResource QuietButton}" VerticalOptions="Center"
                                Command="{Binding StartCallCommand}" IsEnabled="{Binding CanSend}" IsVisible="{Binding ShowCallButton}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Label Text="{Binding TransferText}" IsVisible="{Binding HasTransfers}"
                       FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{Binding [clearHistory], Source={x:Static local:Loc.Instance}}"
                        Command="{Binding ClearHistoryCommand}" IsVisible="{Binding HasMessages}"
                        HorizontalOptions="End" FontSize="12" TextColor="Gray" BackgroundColor="Transparent"
                        Padding="8,0" HeightRequest="32" MinimumHeightRequest="0" />
            </Grid>
            <CollectionView x:Name="MessagesView" Grid.Row="2" ItemsSource="{Binding Messages}"
                            FlowDirection="LeftToRight">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="24">
                        <Label Text="💬" FontSize="54" HorizontalOptions="Center" Opacity="0.6" />
                        <Label Text="{Binding [noChatSelected], Source={x:Static local:Loc.Instance}}"
                               TextColor="Gray" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Border Margin="6,3" Padding="12,8" Stroke="Transparent" StrokeShape="RoundRectangle 16"
                                FlowDirection="{Binding Flow, Source={x:Static local:Loc.Instance}}"
                                HorizontalOptions="{Binding Align}" BackgroundColor="{Binding Bubble}"
                                MaximumWidthRequest="{Binding BubbleMaxWidth, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenFileCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding SenderName}" IsVisible="{Binding HasSender}"
                                           FontSize="11" FontAttributes="Bold" TextColor="#1B3FCF" />
                                    <Label Text="{Binding Display}" TextColor="Black" IsVisible="{Binding ShowName}" />
                                    <Grid IsVisible="{Binding ShowAudioPlayer}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" WidthRequest="230">
                                        <Button Text="{Binding AudioGlyph}" FontSize="18" Padding="0"
                                                WidthRequest="40" HeightRequest="40" CornerRadius="20"
                                                MinimumWidthRequest="0" MinimumHeightRequest="0" VerticalOptions="Center"
                                                Command="{Binding ToggleAudioCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                            <Slider Minimum="0" Maximum="1" Value="{Binding AudioProgress, Mode=OneWay}"
                                                    DragStarted="OnAudioDragStarted" DragCompleted="OnAudioDragCompleted" />
                                            <Label Text="{Binding AudioTime}" FontSize="11" TextColor="#444444" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" FontSize="11" Padding="0" CornerRadius="14"
                                                WidthRequest="44" HeightRequest="28"
                                                MinimumWidthRequest="0" MinimumHeightRequest="0" VerticalOptions="Center"
                                                Text="{Binding AudioSpeedText, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                                Command="{Binding CycleAudioSpeedCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}" />
                                    </Grid>
                                    <Image Source="{Binding Thumb}" IsVisible="{Binding ShowImage}"
                                           WidthRequest="220" HeightRequest="160" Aspect="AspectFill" HorizontalOptions="Start" />
                                    <Grid IsVisible="{Binding ShowVideoBox}" BackgroundColor="#222222" WidthRequest="220" HeightRequest="124"
                                          HorizontalOptions="Start">
                                        <Image Source="{Binding VideoThumb}" Aspect="AspectFill" />
                                        <Border BackgroundColor="#99000000" Stroke="Transparent" StrokeShape="RoundRectangle 24"
                                                WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="▶" TextColor="White" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                    <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding ShowProgress}"
                                                 MinimumWidthRequest="200" />
                                    <Label Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                                           FontSize="11" TextColor="Black" />
                                    <Button Text="{Binding [cancelSend], Source={x:Static local:Loc.Instance}}"
                                            IsVisible="{Binding CanCancel}"
                                            FontSize="12" Padding="10,0" HeightRequest="32" MinimumHeightRequest="0"
                                            HorizontalOptions="Start"
                                            Command="{Binding CancelFileCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="{Binding [retry], Source={x:Static local:Loc.Instance}}"
                                            IsVisible="{Binding CanRetry}"
                                            FontSize="12" Padding="10,0" HeightRequest="32" MinimumHeightRequest="0"
                                            HorizontalOptions="Start"
                                            Command="{Binding RetryFileCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                    <Label Text="{Binding InfoText}" IsVisible="{Binding HasInfo}" FontSize="11" TextColor="#444444" />
                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                                        <Label Text="{Binding [edited], Source={x:Static local:Loc.Instance}}" IsVisible="{Binding IsEdited}"
                                               FontSize="10" TextColor="Gray" VerticalOptions="Center" />
                                        <Label Text="{Binding TimeText}" FontSize="10" TextColor="Gray" VerticalOptions="Center" />
                                        <Button Text="⋮" FontSize="20" TextColor="Gray"
                                                BackgroundColor="Transparent" Padding="0" CornerRadius="0"
                                                WidthRequest="32" HeightRequest="32"
                                                MinimumWidthRequest="0" MinimumHeightRequest="0"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding HasMenu}"
                                                Command="{Binding MessageMenuCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                      </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                <Button Text="📎" FontSize="22" Padding="0" WidthRequest="44" HeightRequest="44"
                        Style="{StaticResource QuietButton}" IsVisible="{Binding NotRecording}"
                        Command="{Binding AttachCommand}" IsEnabled="{Binding CanSend}" />
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,0" HeightRequest="46"
                        StrokeShape="RoundRectangle 22" IsVisible="{Binding IsRecording}">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="●" TextColor="#E53935" FontSize="18" VerticalOptions="Center" />
                        <Label Text="{Binding RecordTime}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="{Binding RecordHint}" FontSize="13" TextColor="Gray" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,0"
                        StrokeShape="RoundRectangle 22" IsVisible="{Binding NotRecording}">
                    <Entry Text="{Binding Draft}" ReturnCommand="{Binding SendCommand}"
                           Placeholder="{Binding DraftPlaceholder}" BackgroundColor="Transparent"
                           HeightRequest="44" />
                </Border>
                <Button Grid.Column="2" Text="↑" FontSize="22" FontAttributes="Bold" Padding="0"
                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                        Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" IsVisible="{Binding ShowSend}" />
                <local:HoldButton x:Name="MediaButton" Grid.Column="2" Text="{Binding MediaButtonText}" FontSize="22" Padding="0"
                                  WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                  IsEnabled="{Binding CanSend}" IsVisible="{Binding ShowMediaButton}">
                    <local:HoldButton.Triggers>
                        <DataTrigger TargetType="local:HoldButton" Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="BackgroundColor" Value="#E53935" />
                        </DataTrigger>
                    </local:HoldButton.Triggers>
                </local:HoldButton>
            </Grid>
        </Grid>

        <BoxView x:Name="Scrim" Color="Black" Opacity="0.45" IsVisible="{Binding ShowScrim}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseDrawerCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="Drawer" HorizontalOptions="Start" WidthRequest="320" TranslationX="-344"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <BoxView WidthRequest="1" HorizontalOptions="End" Color="Gray" Opacity="0.3" />
            <Grid RowDefinitions="Auto,Auto,*" Padding="12,12,12,0" RowSpacing="8"
                  FlowDirection="{Binding Flow, Source={x:Static local:Loc.Instance}}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                    <Label Text="BtChat" FontAttributes="Bold" FontSize="22" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="⚙" FontSize="22" Padding="0" WidthRequest="44" HeightRequest="44"
                            Style="{StaticResource QuietButton}" Command="{Binding OpenSettingsCommand}" />
                    <Button Grid.Column="2" Text="✕" FontSize="18" Padding="0" WidthRequest="44" HeightRequest="44"
                            Style="{StaticResource QuietButton}" Command="{Binding CloseDrawerCommand}" IsVisible="{Binding ShowMenuButton}" />
                </Grid>
                <Label Grid.Row="1" Text="{Binding Status}" FontSize="12" TextColor="Gray" LineBreakMode="WordWrap" />
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Spacing="10" Padding="0,0,0,24">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding [connection], Source={x:Static local:Loc.Instance}}"
                                           FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="ⓘ" FontSize="18" Padding="0" WidthRequest="36" HeightRequest="36"
                                            MinimumWidthRequest="0" MinimumHeightRequest="0"
                                            Style="{StaticResource QuietButton}"
                                            Command="{Binding ShowHelpCommand}" CommandParameter="mode" />
                                </Grid>

                                <!-- connected (or reconnecting) -->
                                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsLinked}">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="●" TextColor="#22C55E" VerticalOptions="Center" />
                                        <Label Text="{Binding LinkedTitle}" FontAttributes="Bold" VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>
                                    <Button Text="{Binding [disconnect], Source={x:Static local:Loc.Instance}}"
                                            BackgroundColor="#EF4444" TextColor="White"
                                            Command="{Binding DisconnectCommand}" />
                                </VerticalStackLayout>

                                <!-- not connected -->
                                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsNotLinked}">
                                    <local:Segmented Items="{Binding ModeItems}" SelectedIndex="{Binding ModeIndex}" />

                                    <!-- Bluetooth -->
                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBluetoothMode}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <Picker ItemsSource="{Binding Devices}" ItemDisplayBinding="{Binding Name}"
                                                    SelectedItem="{Binding SelectedDevice}"
                                                    Title="{Binding [pick], Source={x:Static local:Loc.Instance}}" />
                                            <Button Grid.Column="1" Text="↻" FontSize="20" Padding="0" WidthRequest="44"
                                                    Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}" />
                                            <Button Grid.Column="2" Text="ⓘ" FontSize="18" Padding="0" WidthRequest="36"
                                                    MinimumWidthRequest="0" Style="{StaticResource QuietButton}"
                                                    Command="{Binding ShowHelpCommand}" CommandParameter="bluetooth" />
                                        </Grid>
                                        <Button Text="{Binding [connect], Source={x:Static local:Loc.Instance}}"
                                                Command="{Binding ConnectCommand}" />
                                    </VerticalStackLayout>

                                    <!-- Wi-Fi: easy ways first, manual IP hidden in a drawer -->
                                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsLanMode}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding [easyConnect], Source={x:Static local:Loc.Instance}}"
                                                   Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="ⓘ" FontSize="16" Padding="0" WidthRequest="32" HeightRequest="32"
                                                    MinimumWidthRequest="0" MinimumHeightRequest="0"
                                                    Style="{StaticResource QuietButton}"
                                                    Command="{Binding ShowHelpCommand}" CommandParameter="quick" />
                                        </Grid>

                                        <Border Style="{StaticResource Tile}" IsEnabled="{Binding IsNotSearching}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SearchDevicesCommand}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="4,2">
                                                <Label Text="🔍" FontSize="26" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                    <Label Text="{Binding [tileSearch], Source={x:Static local:Loc.Instance}}"
                                                           FontAttributes="Bold" FontSize="14" />
                                                    <Label Text="{Binding [tileSearchHint], Source={x:Static local:Loc.Instance}}"
                                                           FontSize="11" TextColor="Gray" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Border Style="{StaticResource Tile}" Grid.ColumnSpan="{Binding QrTileSpan}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ShowQrCommand}" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="2" Padding="0,4">
                                                    <Label Text="▦" FontSize="26" HorizontalOptions="Center" />
                                                    <Label Text="{Binding [showQr], Source={x:Static local:Loc.Instance}}"
                                                           FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border Style="{StaticResource Tile}" Grid.Column="1" IsVisible="{Binding CanScanQr}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ScanQrCommand}" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="2" Padding="0,4">
                                                    <Label Text="📷" FontSize="26" HorizontalOptions="Center" />
                                                    <Label Text="{Binding [scanQr], Source={x:Static local:Loc.Instance}}"
                                                           FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding SearchText}" IsVisible="{Binding HasSearchText}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding [foundHeader], Source={x:Static local:Loc.Instance}}" IsVisible="{Binding HasFound}"
                                               FontSize="12" TextColor="Gray" />
                                        <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding FoundDevices}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Tile}" Padding="12,10">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding ConnectFoundCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                                                CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                            <Label Text="📱" FontSize="20" VerticalOptions="Center" />
                                                            <Label Grid.Column="1" Text="{Binding Display}" FontAttributes="Bold"
                                                                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                            <Label Grid.Column="2" Text="›" FontSize="22" TextColor="Gray" VerticalOptions="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <!-- Manual connection drawer: closed until tapped -->
                                        <Border Style="{StaticResource Tile}" Padding="0">
                                            <VerticalStackLayout>
                                                <Grid ColumnDefinitions="*,Auto" Padding="14,0" HeightRequest="48">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ToggleManualCommand}" />
                                                    </Grid.GestureRecognizers>
                                                    <Label Text="{Binding [manualConnect], Source={x:Static local:Loc.Instance}}"
                                                           FontAttributes="Bold" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding ManualArrow}" FontSize="18"
                                                           TextColor="Gray" VerticalOptions="Center" />
                                                </Grid>
                                                <VerticalStackLayout IsVisible="{Binding ManualOpen}" Spacing="8" Padding="14,0,14,14">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Text="{Binding [manualHint], Source={x:Static local:Loc.Instance}}"
                                                               FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                                                        <Button Grid.Column="1" Text="ⓘ" FontSize="16" Padding="0" WidthRequest="32" HeightRequest="32"
                                                                MinimumWidthRequest="0" MinimumHeightRequest="0"
                                                                Style="{StaticResource QuietButton}"
                                                                Command="{Binding ShowHelpCommand}" CommandParameter="ip" />
                                                    </Grid>
                                                    <Entry Text="{Binding Host}" Placeholder="{Binding [ip], Source={x:Static local:Loc.Instance}}" />
                                                    <Button Text="{Binding [connectIp], Source={x:Static local:Loc.Instance}}"
                                                            Command="{Binding ConnectLanCommand}" />
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Label FontSize="13" TextColor="Gray" VerticalOptions="Center">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding [myIp], Source={x:Static local:Loc.Instance}}" />
                                                                    <Span Text=" " />
                                                                    <Span Text="{Binding LocalAddresses}" FontAttributes="Bold" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <Button Grid.Column="1" Text="↻" FontSize="20" Padding="0" WidthRequest="44"
                                                                Style="{StaticResource QuietButton}" Command="{Binding RefreshAddressesCommand}" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="{Binding [chats], Source={x:Static local:Loc.Instance}}" FontAttributes="Bold" FontSize="16" Margin="0,6,0,0" />
                        <Label Text="{Binding [noChats], Source={x:Static local:Loc.Instance}}" IsVisible="{Binding HasNoChats}"
                               FontSize="12" TextColor="Gray" />
                        <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Conversations}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Stroke="Transparent" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{Binding RowColor}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenChatCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                                                    BackgroundColor="#3B82F6" Stroke="Transparent">
                                                <Label Text="{Binding Initial}" TextColor="White" FontAttributes="Bold"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label Text="{Binding Preview}" FontSize="12" TextColor="Gray"
                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                                <Border IsVisible="{Binding HasUnread}" BackgroundColor="#EF4444" Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 10" Padding="6,1" VerticalOptions="Center">
                                                    <Label Text="{Binding UnreadText}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                                </Border>
                                                <Label Text="●" TextColor="#22C55E" IsVisible="{Binding IsLinked}" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Button Grid.Column="3" Text="⋮" FontSize="20" TextColor="Gray"
                                                    BackgroundColor="Transparent" Padding="0" CornerRadius="0"
                                                    WidthRequest="32" HeightRequest="32"
                                                    MinimumWidthRequest="0" MinimumHeightRequest="0"
                                                    Command="{Binding ChatMenuCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <BoxView Color="Black" Opacity="0.55" IsVisible="{Binding ShowLog}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseLogCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Grid x:Name="CallOverlay" IsVisible="{Binding ShowCall}" RowDefinitions="*,Auto">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F1720" Offset="0.0" />
                    <GradientStop Color="#1B2B3C" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Resources>
                <Style x:Key="CallRound" TargetType="Button">
                    <Setter Property="FontSize" Value="22" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="WidthRequest" Value="52" />
                    <Setter Property="HeightRequest" Value="52" />
                    <Setter Property="CornerRadius" Value="26" />
                    <Setter Property="BackgroundColor" Value="#33FFFFFF" />
                    <Setter Property="TextColor" Value="White" />
                    <Setter Property="Margin" Value="6" />
                </Style>
                <Style x:Key="CallMain" TargetType="Button">
                    <Setter Property="FontSize" Value="30" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="WidthRequest" Value="72" />
                    <Setter Property="HeightRequest" Value="72" />
                    <Setter Property="CornerRadius" Value="36" />
                    <Setter Property="TextColor" Value="White" />
                </Style>
            </Grid.Resources>

            <local:VideoFrameView x:Name="RemoteVideo" Grid.RowSpan="2" IsVisible="{Binding ShowVideoStage}" />
            <BoxView Grid.RowSpan="2" VerticalOptions="Start" HeightRequest="120" IsVisible="{Binding ShowVideoStage}">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <VerticalStackLayout Grid.RowSpan="2" VerticalOptions="Start" HorizontalOptions="Start" Margin="20,44,0,0"
                                 IsVisible="{Binding ShowVideoStage}">
                <Label TextColor="White" FontAttributes="Bold" FontSize="20" Text="{Binding CallPeerName}" />
                <Label TextColor="#DDFFFFFF" FontSize="14" Text="{Binding CallStatusText}" />
            </VerticalStackLayout>

            <Border x:Name="LocalPreview" Grid.RowSpan="2" WidthRequest="104" HeightRequest="140" HorizontalOptions="End" VerticalOptions="Start"
                    Margin="0,44,16,0" StrokeThickness="2" Stroke="#CCFFFFFF" StrokeShape="RoundRectangle 16"
                    IsVisible="{Binding ShowVideoStage}">
                <local:VideoFrameView x:Name="LocalVideo" Crop="True" />
            </Border>

            <VerticalStackLayout Grid.Row="0" Spacing="12" VerticalOptions="Center" HorizontalOptions="Center" Margin="24,0"
                                 IsVisible="{Binding ShowAvatar}">
                <Border WidthRequest="132" HeightRequest="132" StrokeThickness="6" Stroke="#33FFFFFF" StrokeShape="RoundRectangle 66"
                        BackgroundColor="{StaticResource AccentColor}" HorizontalOptions="Center">
                    <Label Text="{Binding CallInitial}" TextColor="White" FontAttributes="Bold" FontSize="54"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding CallPeerName}" TextColor="White" FontSize="26" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                <Label Text="{Binding CallStatusText}" TextColor="#CCFFFFFF" FontSize="16" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Grid.Row="1" HorizontalOptions="Center" MaximumWidthRequest="460" Margin="12,0,12,20" Padding="10,12"
                    StrokeThickness="0" StrokeShape="RoundRectangle 32" BackgroundColor="#B3141C26">
                <VerticalStackLayout Spacing="10">
                    <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                        <Button Style="{StaticResource CallRound}" Text="{Binding CameraGlyph}"
                                IsVisible="{Binding ShowVideoControls}" Command="{Binding ToggleCameraCommand}" />
                        <Button Style="{StaticResource CallRound}" Text="🔄"
                                IsVisible="{Binding ShowVideoControls}" Command="{Binding SwitchCameraCommand}" />
                        <Button Style="{StaticResource CallRound}" Text="⚙"
                                IsVisible="{Binding ShowVideoControls}" Command="{Binding ChooseVideoQualityCommand}" />
                        <Button Style="{StaticResource CallRound}" Text="{Binding MuteGlyph}"
                                IsVisible="{Binding ShowCallControls}" Command="{Binding ToggleMuteCommand}" />
                        <Button Style="{StaticResource CallRound}" Text="{Binding SpeakerGlyph}"
                                IsVisible="{Binding ShowCallControls}" Command="{Binding ToggleSpeakerCommand}" />
                    </FlexLayout>
                    <HorizontalStackLayout Spacing="36" HorizontalOptions="Center">
                        <Button Style="{StaticResource CallMain}" Text="📞" BackgroundColor="#22C55E"
                                IsVisible="{Binding ShowAccept}" Command="{Binding AcceptCallCommand}" />
                        <Button Style="{StaticResource CallMain}" Text="✖" BackgroundColor="#E53935"
                                Command="{Binding DeclineCallCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Border x:Name="LogCard" IsVisible="{Binding ShowLog}" HorizontalOptions="Center" VerticalOptions="Center"
                WidthRequest="520" HeightRequest="480" Padding="12" StrokeShape="RoundRectangle 14" Stroke="Gray"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8"
                  FlowDirection="{Binding Flow, Source={x:Static local:Loc.Instance}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding [logTitle], Source={x:Static local:Loc.Instance}}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="✕" FontSize="16" Padding="0" WidthRequest="36" HeightRequest="36"
                            MinimumWidthRequest="0" MinimumHeightRequest="0" CornerRadius="18"
                            Command="{Binding CloseLogCommand}" />
                </Grid>
                <Editor Grid.Row="1" Text="{Binding LogText}" IsReadOnly="True" FontSize="11" />
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button Text="{Binding [copy], Source={x:Static local:Loc.Instance}}" Command="{Binding CopyLogCommand}" />
                    <Button Grid.Column="1" Text="{Binding [clear], Source={x:Static local:Loc.Instance}}" Command="{Binding ClearLogCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
