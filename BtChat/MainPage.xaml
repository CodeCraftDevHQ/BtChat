<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BtChat"
             x:Class="BtChat.MainPage"
             FlowDirection="{Binding Flow, Source={x:Static local:Loc.Instance}}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="8" RowSpacing="6">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Label Text="{Binding Status}" VerticalOptions="Center" FontAttributes="Bold" LineBreakMode="TailTruncation" />
            <Button Grid.Column="1" Text="{Binding [log], Source={x:Static local:Loc.Instance}}"
                    Command="{Binding ToggleLogCommand}" />
            <Button Grid.Column="2" Text="{Binding [lang], Source={x:Static local:Loc.Instance}}"
                    Command="{Binding ToggleLanguageCommand}" />
        </Grid>
        <Picker Grid.Row="1" Title="{Binding [mode], Source={x:Static local:Loc.Instance}}"
                SelectedIndex="{Binding ModeIndex}">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Bluetooth</x:String>
                    <x:String>Wi-Fi / IP</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
        <Grid Grid.Row="2">
            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsBluetoothMode}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Picker ItemsSource="{Binding Devices}" ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedDevice}"
                            Title="{Binding [pick], Source={x:Static local:Loc.Instance}}" />
                    <Button Grid.Column="1" Text="{Binding [refresh], Source={x:Static local:Loc.Instance}}"
                            Command="{Binding RefreshCommand}" />
                </Grid>
                <Grid>
                    <Button Text="{Binding [connect], Source={x:Static local:Loc.Instance}}"
                            Command="{Binding ConnectCommand}" IsVisible="{Binding IsNotLinked}" />
                    <Button Text="{Binding [disconnect], Source={x:Static local:Loc.Instance}}"
                            Command="{Binding DisconnectCommand}" IsVisible="{Binding IsLinked}" />
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsLanMode}">
                <Entry Text="{Binding Host}" Placeholder="{Binding [ip], Source={x:Static local:Loc.Instance}}" />
                <Grid>
                    <Button Text="{Binding [connectIp], Source={x:Static local:Loc.Instance}}"
                            Command="{Binding ConnectLanCommand}" IsVisible="{Binding IsNotLinked}" />
                    <Button Text="{Binding [disconnect], Source={x:Static local:Loc.Instance}}"
                            Command="{Binding DisconnectCommand}" IsVisible="{Binding IsLinked}" />
                </Grid>
                <Label FontSize="12" TextColor="Gray">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding [myIp], Source={x:Static local:Loc.Instance}}" />
                            <Span Text=" " />
                            <Span Text="{Binding LocalAddresses}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </Grid>
        <Button Grid.Row="3" Text="{Binding [clearHistory], Source={x:Static local:Loc.Instance}}"
                Command="{Binding ClearHistoryCommand}" IsVisible="{Binding HasMessages}"
                HorizontalOptions="End" FontSize="12" TextColor="Gray" BackgroundColor="Transparent"
                Padding="8,0" HeightRequest="32" MinimumHeightRequest="0" />
        <CollectionView x:Name="MessagesView" Grid.Row="4" ItemsSource="{Binding Messages}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" Padding="10,6" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                            HorizontalOptions="{Binding Align}" BackgroundColor="{Binding Bubble}"
                            MaximumWidthRequest="420">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenFileCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Display}" TextColor="Black" />
                                <ProgressBar Progress="{Binding Progress}" IsVisible="{Binding ShowProgress}"
                                             MinimumWidthRequest="200" />
                                <Label Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                                       FontSize="11" TextColor="Black" />
                                <Button Text="{Binding [cancelSend], Source={x:Static local:Loc.Instance}}"
                                        IsVisible="{Binding CanCancel}"
                                        FontSize="12" Padding="10,0" HeightRequest="32" MinimumHeightRequest="0"
                                        HorizontalOptions="Start"
                                        Command="{Binding CancelFileCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                <Label Text="{Binding TimeText}" FontSize="10" TextColor="Gray" HorizontalOptions="End" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="⋮" FontSize="20" TextColor="Gray"
                                    BackgroundColor="Transparent" Padding="0" CornerRadius="0"
                                    WidthRequest="32" HeightRequest="32"
                                    MinimumWidthRequest="0" MinimumHeightRequest="0"
                                    VerticalOptions="Start"
                                    IsVisible="{Binding HasMenu}"
                                    Command="{Binding MessageMenuCommand, Source={RelativeSource AncestorType={x:Type local:MainViewModel}}}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="4" RowDefinitions="*,Auto" ColumnDefinitions="*,*" ColumnSpacing="6" RowSpacing="6"
              IsVisible="{Binding ShowLog}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <Editor Grid.ColumnSpan="2" Text="{Binding LogText}" IsReadOnly="True" FontSize="11" />
            <Button Grid.Row="1" Text="{Binding [copy], Source={x:Static local:Loc.Instance}}" Command="{Binding CopyLogCommand}" />
            <Button Grid.Row="1" Grid.Column="1" Text="{Binding [clear], Source={x:Static local:Loc.Instance}}" Command="{Binding ClearLogCommand}" />
        </Grid>
        <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <Button Text="📎" Command="{Binding AttachCommand}" IsEnabled="{Binding IsConnected}" />
            <Entry Grid.Column="1" Text="{Binding Draft}" ReturnCommand="{Binding SendCommand}"
                   Placeholder="{Binding [type], Source={x:Static local:Loc.Instance}}" />
            <Button Grid.Column="2" Text="{Binding [send], Source={x:Static local:Loc.Instance}}"
                    Command="{Binding SendCommand}" IsEnabled="{Binding IsConnected}" />
        </Grid>
    </Grid>
</ContentPage>
